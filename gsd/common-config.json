{
  "_comment": "Dotted-path keys are merged into each platform repository's .planning/config.json without replacing repo-local settings. The native GSD MemPalace capability is intentionally fail-closed because its generic handlers use the wrong server namespace, raw artifact capture, unsupported rooms, KG, diary, tunnels, and ship-time curation. The managed SolidStats GSD.md adapter owns coordinator recall and semantic closure instead. mempalace.wing is repository-specific and is written from config/repositories.tsv by sync-gsd-config.mjs.",

  "workflow.research": true,
  "workflow.plan_check": true,
  "workflow.verifier": true,
  "workflow.nyquist_validation": true,
  "workflow.auto_prune_state": false,
  "workflow.auto_advance": false,
  "workflow.node_repair": true,
  "workflow.node_repair_budget": 2,
  "workflow.text_mode": false,
  "workflow.research_before_questions": true,
  "workflow.discuss_mode": "assumptions",
  "workflow.subagent_timeout": 1200000,
  "workflow.inline_plan_threshold": 2,
  "workflow.code_review": true,
  "workflow.code_review_depth": "deep",
  "workflow.security_enforcement": true,
  "workflow.security_asvs_level": 2,
  "workflow.security_block_on": "high",
  "workflow.post_planning_gaps": true,
  "workflow.plan_review_convergence": true,

  "git.branching_strategy": "milestone",
  "git.phase_branch_template": "gsd/phase-{phase}-{slug}",
  "git.milestone_branch_template": "gsd/{milestone}-{slug}",

  "hooks.context_warnings": true,
  "hooks.workflow_guard": true,

  "learnings.max_inject": 10,

  "intel.enabled": true,

  "parallelization": true,

  "graphify.enabled": true,

  "mempalace.enabled": false,
  "mempalace.memory_mode": "augment",
  "mempalace.recall_on_discuss": false,
  "mempalace.recall_on_plan": false,
  "mempalace.capture_artifacts": false,
  "mempalace.mirror_kg": false,
  "mempalace.cross_project_tunnels": false,
  "mempalace.diary_journal": false,
  "mempalace.auto_capture_hooks": false
}
